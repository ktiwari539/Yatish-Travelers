FROM node:22-bookworm-slim
# unzip is needed by the existing reviewed fleet media importer.
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node server ./server
COPY --chown=node:node public ./public
RUN mkdir -p /data /app/public/media && chown node:node /data /app/public/media
ENV NODE_ENV=production CRM_HOST=0.0.0.0 CRM_PORT=8787 CRM_STORAGE_ROOT=/data \
    CRM_DATA_FILE=/data/enquiries.jsonl CRM_EVENTS_FILE=/data/events.jsonl \
    CRM_NOTIFICATIONS_FILE=/data/notification-events.jsonl CRM_CATALOG_FILE=/data/catalog.json \
    CRM_UPLOADS_DIR=/data/uploads CRM_MODELS_DIR=/data/models CRM_NOTIFICATIONS_MODE=preview
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/crm.mjs"]
