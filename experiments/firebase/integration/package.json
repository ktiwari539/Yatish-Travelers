{
  "name": "mateshwari-firebase-isolated-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/validate-web-env.mjs && vite build && node scripts/check-client-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:emulators": "node scripts/run-emulator-tests.mjs",
    "emulators": "firebase emulators:start --project demo-mateshwari-poc --only auth,firestore",
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/local-api.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "firebase-tools": "15.34.2",
    "vite": "7.3.7"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
